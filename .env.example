# --- Neon Postgres -----------------------------------------------------------
# Pooled connection (used by the app at request time). Neon dashboard → project
# → Connection Details → enable "Pooled connection".
DATABASE_URL="postgres://USER:PASSWORD@HOST/jornada?sslmode=require&pgbouncer=true&connect_timeout=10"

# Direct connection (no PgBouncer) — used by `prisma migrate`.
DIRECT_URL="postgres://USER:PASSWORD@HOST/jornada?sslmode=require"

# --- Resend ------------------------------------------------------------------
# Resend dashboard → API Keys → Create API Key (sending access only).
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXX"

# Verified sender. For v1 you can use Resend's sandbox: onboarding@resend.dev
RESEND_FROM_EMAIL="Jornada <onboarding@resend.dev>"

# --- Session cookie ---------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-chars-of-randomness-XXXXXX"

# --- Public app URL ---------------------------------------------------------
# Local development uses http://localhost:3000. After your first Vercel
# deploy, set this to your assigned *.vercel.app URL (and re-deploy).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
